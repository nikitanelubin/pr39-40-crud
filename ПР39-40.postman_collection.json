    {
      "name": "2. Создание стипендии (Create)",
      "description": "Задание 2: POST с проверкой полей.",
      "item": [
        {
          "name": "2.1 Создать стипендию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scholarships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scholarships"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": 1,\n  \"type\": \"Академическая\",\n  \"amount\": 3500,\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2027-01-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Создаёт запись и возвращает её со статусом 201. ID новой записи сохраняется в переменную `scholarshipId` для следующих запросов. После запроса запись видна в phpMyAdmin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201: 2.1 Создать стипендию', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('scholarshipId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Неполные данные",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scholarships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scholarships"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Академическая\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Нет обязательных полей: статус 400 и текст первой ошибки (например `student_id must be a positive integer`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 400: 2.2 Неполные данные', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Студента не существует (ошибка БД)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scholarships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scholarships"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": 999,\n  \"type\": \"Академическая\",\n  \"amount\": 3500,\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2027-01-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Поля заполнены верно, поэтому проверка пройдена, но студента с ID 999 нет. База не даёт сохранить запись из-за внешнего ключа (FOREIGN KEY), срабатывает catch: статус 500 `Failed to create scholarship`. Так проверяется пункт задания «ошибки БД — 500»."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 500: 2.3 Студента не существует (ошибка БД)', () => pm.response.to.have.status(500));"
                ]
              }
            }
          ]
        }
      ]
