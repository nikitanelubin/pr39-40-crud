{
  "info": {
    "name": "ПР 39-40. CRUD-операции (стипендии и студенты)",
    "description": "API стипендий и студентов, вариант 7. Сервер: в папке проекта `node index.js`, адрес http://localhost:3002.\n\nЗапросы выполняются по порядку сверху вниз. ID созданной записи сохраняется в переменную коллекции автоматически (вкладка Tests у запроса).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Чтение стипендий (Read)",
      "description": "Задание 1: GET со списком, фильтром и поиском по ID.",
      "item": [
        {
          "name": "1.1 Список всех стипендий",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scholarships",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scholarships"
              ]
            },
            "description": "Возвращает все стипендии вместе с ФИО студента (JOIN с таблицей students)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200: 1.1 Список всех стипендий', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Фильтр по типу: Социальная",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scholarships?type=Социальная",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scholarships"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "Социальная"
                }
              ]
            },
            "description": "Параметр `type` передаётся в запрос к БД через `?` (параметризованный запрос), поэтому SQL-инъекция невозможна."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200: 1.2 Фильтр по типу: Социальная', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Стипендия по ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scholarships/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scholarships",
                "1"
              ]
            },
            "description": "Одна запись по ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200: 1.3 Стипендия по ID', () => pm.response.to.have.status(200));"
